SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional fallback if you configure RLS policies for the ingestion CLI.
SUPABASE_ANON_KEY=your-anon-public-key

FOREPLAY_API_KEY=your-foreplay-api-key
FOREPLAY_BASE_URL=https://public.api.foreplay.co

TOPYAPPERS_API_KEY=your-topyappers-api-key
TOPYAPPERS_BASE_URL=https://api.topyappers.com

APIFY_API_KEY=your-apify-api-key

CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-haiku-4-5

# Local dev only. Use if your Python install cannot find macOS certificates.
# Do not use in production.
INSTAAGENT_INSECURE_SSL=0
