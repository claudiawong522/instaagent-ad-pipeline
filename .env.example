SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

CLAUDE_API_KEY=
APIFY_API_KEY=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-haiku-4-5
OPENROUTER_MODEL=google/gemini-3-flash-preview
EMBEDDING_MODEL=voyage-4-lite
GEMINI_MODEL=gemini-flash-latest
# Set to "gemini" to use the official Gemini API (GEMINI_API_KEY) for video enrichment instead of OpenRouter
ENRICHMENT_PROVIDER=openrouter

# Parser-drift reminder email (drift_alert.py). When a scheduled trend scrape detects that a
# newsletter changed layout, it emails ALERT_EMAIL_TO. Unset SMTP creds disable sending (the
# drift is only logged; --fail-on-drift still turns the run red). Defaults suit Gmail: user =
# Gmail address, password = an app password from myaccount.google.com/apppasswords. Any free
# relay works via ALERT_SMTP_HOST/PORT (port 465 = SSL, else STARTTLS); for relays whose login
# isn't the sender (e.g. Brevo), set ALERT_EMAIL_FROM to the verified sender address.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_TO=instaagenttool@gmail.com
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465
# ALERT_EMAIL_FROM=
