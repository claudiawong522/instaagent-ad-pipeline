SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

CLAUDE_API_KEY=
APIFY_API_KEY=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-haiku-4-5
OPENROUTER_MODEL=google/gemini-3-flash-preview
EMBEDDING_MODEL=voyage-4-lite
GEMINI_MODEL=gemini-flash-latest
# Set to "gemini" to use the official Gemini API (GEMINI_API_KEY) for video enrichment instead of OpenRouter
ENRICHMENT_PROVIDER=openrouter
